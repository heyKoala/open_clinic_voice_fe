# Copy to .env.local. Only needed for the "Test AI Call" page when the backend runs on localhost:
# the public URL (tunnel) through which the voice provider can reach the backend on port 8001.
VITE_PUBLIC_BACKEND_URL=
# The voice provider's LiveKit server for test calls (defaults to HeyKoala's: wss://eu-heykoala-c5eadreu.livekit.cloud).
VITE_LIVEKIT_URL=
