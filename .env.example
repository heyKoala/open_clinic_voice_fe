# Copy to .env.local only if you need to change these. Both are optional; nothing secret belongs here
# (every VITE_ value is built into the public JavaScript).

# The backend's API address. Leave empty in development: the dev server forwards /api to the backend on
# port 8001. Set it in production when the backend is on another domain, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=

# Optional, Test call page only: a public URL for the backend. Not needed when the backend has
# PUBLIC_BASE_URL set (it tells the voice service its own address).
VITE_PUBLIC_BACKEND_URL=
